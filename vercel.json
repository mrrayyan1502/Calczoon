{
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/blog/top-financial-calculators-2025",
      "destination": "/blog/top-financial-calculators-for-financial-planning",
      "permanent": true
    },
    {
      "source": "/math/triangle-area-calculator-with-steps",
      "destination": "/math/triangle-calculator",
      "permanent": true
    },
    {
      "source": "/health/vo2-max-calculator",
      "destination": "/health-fitness-calculators",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/calculators",
      "permanent": true
    },
    {
      "source": "/health",
      "destination": "/health-fitness-calculators",
      "permanent": true
    },
    {
      "source": "/financial",
      "destination": "/financial-calculators",
      "permanent": true
    },
    {
      "source": "/math",
      "destination": "/math-science-calculators",
      "permanent": true
    },
    {
      "source": "/lifestyle",
      "destination": "/lifestyle-everyday-calculators",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
